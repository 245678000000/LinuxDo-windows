<Window x:Class="LinuxDo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinuxDo 设置" Width="580" Height="640" MinWidth="480" MinHeight="480"
        Icon="Resources/AppIcon.ico" WindowStartupLocation="CenterScreen">
    <TabControl Margin="16,12,16,16">
        <TabItem Header="外观与阅读">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,4,20,20">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="外观" />
                    <TextBlock Style="{StaticResource SectionNote}" Text="窗口和网页默认跟随 Windows 的浅色/深色设置，也可以单独指定。窗口材质跟随系统的透明效果设置。" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="AppearanceSystem" GroupName="Appearance" Content="跟随系统" Margin="0,0,16,0" Checked="OnAppearanceChecked" />
                        <RadioButton x:Name="AppearanceLight" GroupName="Appearance" Content="浅色" Margin="0,0,16,0" Checked="OnAppearanceChecked" />
                        <RadioButton x:Name="AppearanceDark" GroupName="Appearance" Content="深色" Checked="OnAppearanceChecked" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="阅读排版" />
                    <TextBlock Style="{StaticResource SectionNote}" Text="只调整帖子正文；代码、登录与回复功能保持原样。" />
                    <CheckBox x:Name="ReadingCheck" Content="启用舒适阅读排版" Click="OnReadingClick" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字号" VerticalAlignment="Center" />
                        <Slider x:Name="FontSlider" Grid.Column="1" Minimum="13" Maximum="22" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" AutomationProperties.Name="正文字号" ValueChanged="OnFontChanged" />
                        <TextBlock x:Name="FontValue" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="行距" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="LineCompact" GroupName="Line" Content="紧凑" Margin="0,0,16,0" Checked="OnLineChecked" />
                            <RadioButton x:Name="LineComfortable" GroupName="Line" Content="舒适" Margin="0,0,16,0" Checked="OnLineChecked" />
                            <RadioButton x:Name="LineLoose" GroupName="Line" Content="宽松" Checked="OnLineChecked" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="HideWebSidebarCheck" Content="显示原生侧栏时，收起网页侧栏" Margin="0,14,0,0" Click="OnHideWebSidebarClick" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="浏览与下载">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,4,20,20">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="继续上次的阅读" />
                    <TextBlock Style="{StaticResource SectionNote}" Text="重新打开时恢复最后页面和阅读位置。此功能不读取或保存回复内容。" />
                    <CheckBox x:Name="RestoreCheck" Content="恢复阅读位置" Click="OnRestoreClick" />
                    <Button Content="清除本地阅读位置…" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,5" Click="OnClearPositions" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="下载" />
                    <TextBlock Style="{StaticResource SectionNote}" Text="默认保存到“下载”文件夹，进度显示在工具栏的下载面板中，不打断当前操作。" />
                    <CheckBox x:Name="AskDownloadCheck" Content="每次下载前询问保存位置" Click="OnAskDownloadClick" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="键盘操作" />
                    <TextBlock Style="{StaticResource SectionNote}" FontFamily="Segoe UI, Microsoft YaHei UI" LineHeight="22"
                               Text="Ctrl+L　搜索社区　　　　Ctrl+F　页内查找&#x0a;Ctrl+N　新窗口　　　　　Ctrl+W　关闭窗口&#x0a;Alt+← / Alt+→　后退 / 前进　　F5　重新加载&#x0a;Ctrl+点击站内链接　在新窗口打开&#x0a;Ctrl+Shift+S　显示或收起侧栏　　Ctrl+J　下载&#x0a;Ctrl+,　打开设置" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="网络">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,4,20,20">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="连接方式" />
                    <TextBlock Style="{StaticResource SectionNote}" Text="默认跟随 Windows 的代理设置。独立代理支持 HTTP 和 SOCKS5，只对 LinuxDo 生效。" />
                    <CheckBox x:Name="ProxyCheck" Content="为 LinuxDo 单独使用代理" />
                    <TextBox x:Name="ProxyBox" Margin="0,10,0,0" Width="420" HorizontalAlignment="Left" AutomationProperties.Name="代理地址" />
                    <TextBlock x:Name="ProxyStatus" Style="{StaticResource SectionNote}" Margin="0,8,0,0" />
                    <Button Content="保存网络设置" HorizontalAlignment="Left" Padding="12,5" Style="{DynamicResource AccentButtonStyle}" Click="OnSaveNetwork" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
