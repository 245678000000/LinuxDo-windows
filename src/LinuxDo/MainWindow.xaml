<Window x:Class="LinuxDo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LinuxDo" Width="1280" Height="840" MinWidth="860" MinHeight="560"
        Icon="Resources/AppIcon.ico" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Margin="8,6,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SidebarButton" Style="{StaticResource ToolButton}" Content="&#xE700;"
                    ToolTip="显示或收起侧栏（Ctrl+Shift+S）" AutomationProperties.Name="显示或收起侧栏" Click="OnSidebarClick" />
            <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource ToolButton}" Content="&#xE72B;" IsEnabled="False"
                    ToolTip="后退（Alt+←）" AutomationProperties.Name="后退" Click="OnBackClick" />
            <Button x:Name="ForwardButton" Grid.Column="2" Style="{StaticResource ToolButton}" Content="&#xE72A;" IsEnabled="False"
                    ToolTip="前进（Alt+→）" AutomationProperties.Name="前进" Click="OnForwardClick" />

            <Grid Grid.Column="4" Width="280" Margin="8,0" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Padding="34,6,10,6" VerticalContentAlignment="Center"
                         AutomationProperties.Name="搜索社区" ToolTip="搜索社区（Ctrl+L）"
                         KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SearchPlaceholder" Text="搜索社区" Margin="35,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>

            <Button x:Name="ReloadButton" Grid.Column="5" Style="{StaticResource ToolButton}" Content="&#xE72C;"
                    ToolTip="重新加载（F5）" AutomationProperties.Name="重新加载" Click="OnReloadClick" />
            <Button x:Name="DownloadsButton" Grid.Column="6" Style="{StaticResource ToolButton}" Content="&#xE896;"
                    ToolTip="下载（Ctrl+J）" AutomationProperties.Name="下载" Click="OnDownloadsClick" />
            <Button x:Name="CopyLinkButton" Grid.Column="7" Style="{StaticResource ToolButton}" Content="&#xE71B;"
                    ToolTip="复制页面链接" AutomationProperties.Name="复制页面链接" Click="OnCopyLinkClick" />
            <Button x:Name="MoreButton" Grid.Column="8" Style="{StaticResource ToolButton}" Content="&#xE712;"
                    ToolTip="更多操作" AutomationProperties.Name="更多操作" Click="OnMoreClick" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="248" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <!-- Native sidebar, collapsed by default: the site has its own. -->
            <DockPanel x:Name="Sidebar" Margin="6,4,2,12">
                <StackPanel DockPanel.Dock="Top" Margin="16,10,12,18">
                    <TextBlock Text="LINUX DO" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="SidebarSubtitle" Text="连接 · 分享 · 探索" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="8,8,0,0" Padding="10,6"
                        Click="OnSettingsClick" AutomationProperties.Name="设置">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="设置" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ListBox x:Name="SidebarList" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="社区导航" SelectionChanged="OnSidebarSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Focusable="False" DragCompleted="OnSplitterDragCompleted" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Top" />
                <Border x:Name="ProgressLine" Height="2" Background="{StaticResource BrandGoldBrush}" Opacity="0"
                        VerticalAlignment="Top" RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                    </Border.RenderTransform>
                </Border>

                <!-- WebView2 is a native window, so notices sit above it instead of floating over it. -->
                <Border x:Name="Notice" Grid.Row="1" Visibility="Collapsed" Margin="12,8,12,8" Padding="14,8,8,8"
                        CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel>
                        <Button x:Name="NoticeDismiss" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Width="32" Height="28"
                                FontSize="12" Content="&#xE711;" ToolTip="关闭提示" AutomationProperties.Name="关闭提示" Click="OnNoticeDismiss" />
                        <Button x:Name="NoticeAction" DockPanel.Dock="Right" Margin="12,0,4,0" Padding="12,4" Click="OnNoticeAction" />
                        <TextBlock x:Name="NoticeText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                </Border>

                <wv2:WebView2 x:Name="Web" Grid.Row="2" />

                <StackPanel x:Name="ErrorOverlay" Grid.Row="2" Visibility="Collapsed" MaxWidth="420"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xF384;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="暂时没有连接上" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ErrorMessage" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="RetryButton" Content="重新加载" HorizontalAlignment="Center" Margin="0,18,0,0" Padding="16,6"
                            Style="{DynamicResource AccentButtonStyle}" Click="OnReloadClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
